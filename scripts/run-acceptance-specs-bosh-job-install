#!/usr/bin/env bash
set -euo pipefail

set -x

# Deploys bpm as a BOSH job next to the test-server and runs the acceptance
# specs against it. Expects BOSH_ENVIRONMENT etc. to target a director that
# has the bpm release and a stemcell named STEMCELL_NAME uploaded.

RELEASE_PATH="$(cd "$(dirname "$0")/.." && pwd)"
export RELEASE_PATH
export BOSH_DEPLOYMENT="${BOSH_DEPLOYMENT:-bpm}"

# shellcheck source=scripts/lib/acceptance.bash
source "${RELEASE_PATH}/scripts/lib/acceptance.bash"

bosh deploy \
  "${RELEASE_PATH}/manifests/bosh-lite-ci.yml" \
  -v "stemcell_name=${STEMCELL_NAME}" \
  -v "stemcell_version=${STEMCELL_VERSION:-latest}"

run_specs

# Installed as a BOSH job, bpm runs tini from its package.
expect_arg0 /var/vcap/packages/bpm/bin/tini
